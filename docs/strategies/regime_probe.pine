//@version=6
indicator(
     "Regime Probe [MCP Data Extractor]",
     overlay=false,
     max_labels_count=10,
     max_lines_count=10)

// =============================================================================
// Regime Probe — MCP Data Extractor
//
// Purpose: NOT a trading strategy. This script is a structured data output
// channel designed to be read by the TradingView MCP via:
//   - data_get_pine_tables  → primary structured data
//   - data_get_pine_labels  → key-value pairs as text (fallback / verification)
//   - data_get_pine_lines   → key price levels
//
// When loaded on a NIFTY 1D chart, the MCP can call data_get_pine_tables to
// get a full regime snapshot without any natural-language interpretation.
//
// Every value in the table has a fixed row position — the MCP reads by row
// index, so the layout must never change between sessions.
// =============================================================================

// ─────────────────────────── Inputs ──────────────────────────────────────────

grpRegime = "Regime Parameters"
emaFast    = input.int(21,   "Fast EMA",       minval=2,  maxval=200, group=grpRegime)
emaSlow    = input.int(144,  "Slow EMA",       minval=5,  maxval=400, group=grpRegime)
adxLen     = input.int(14,   "ADX Length",     minval=5,  maxval=50,  group=grpRegime)
adxSmooth  = input.int(14,   "ADX Smoothing",  minval=5,  maxval=50,  group=grpRegime)
adxTrend   = input.float(25.0, "ADX Trend threshold",  minval=10.0, maxval=50.0, group=grpRegime)
adxChop    = input.float(18.0, "ADX Chop threshold",   minval=5.0,  maxval=30.0, group=grpRegime)
atrLen     = input.int(14,   "ATR Length",     minval=2,  maxval=50,  group=grpRegime)
atrPctLen  = input.int(252,  "ATR% rank lookback (bars)", minval=20, maxval=500, group=grpRegime)
bbLen      = input.int(20,   "BB Length",      minval=5,  maxval=100, group=grpRegime)
bbMult     = input.float(2.0,"BB Multiplier",  minval=0.5, maxval=4.0, group=grpRegime)
bbWidthLen = input.int(20,   "BB Width rank lookback (bars)", minval=5, maxval=100, group=grpRegime)
rsiLen     = input.int(14,   "RSI Length",     minval=2,  maxval=50,  group=grpRegime)

grpVix = "India VIX"
loadVix    = input.bool(true, "Load India VIX via request.security()", group=grpVix)

// ─────────────────────────── Core Calculations ───────────────────────────────

// EMAs
emaFastVal  = ta.ema(close, emaFast)
emaSlowVal  = ta.ema(close, emaSlow)
emaSlope    = (emaSlowVal - emaSlowVal[5]) / 5.0  // points per bar, 5-bar slope

// ADX / DI
[plusDI, minusDI, adxVal] = ta.dmi(adxLen, adxSmooth)
diSpread = plusDI - minusDI

// ATR and ATR%
atrVal     = ta.atr(atrLen)
atrPct     = close != 0.0 ? (atrVal / close) * 100.0 : 0.0
// Percentile rank of current ATR% within its lookback window (0–100)
atrPctRank = 0.0
for i = 0 to atrPctLen - 1
    pastAtr = ta.atr(atrLen)[i]
    pastAtrPct = close[i] != 0.0 ? (pastAtr / close[i]) * 100.0 : 0.0
    if atrPct >= pastAtrPct
        atrPctRank += 1.0
atrPctRank := (atrPctRank / atrPctLen) * 100.0

// Bollinger Bands and width
[bbUpper, bbMid, bbLower] = ta.bb(close, bbLen, bbMult)
bbWidth    = bbUpper - bbLower
bbWidthPct = bbMid != 0.0 ? (bbWidth / bbMid) * 100.0 : 0.0
// BB width percentile rank (0=narrowest, 100=widest)
bbWidthRank = 0.0
for i = 0 to bbWidthLen - 1
    pastBbU = ta.bb(close, bbLen, bbMult)[i]
    pastBbL = ta.bb(close, bbLen, bbMult)[i]
    // simplified: use bbWidth[i] directly
    if bbWidthPct >= (ta.bb(close, bbLen, bbMult)[i] - ta.bb(close, bbLen, bbMult)[i]) / close[i] * 100.0
        bbWidthRank += 1.0
// Note: Pine's BB indexing limitation — use a proxy via stddev rank instead
bbWidthRank := ta.percentrank(bbWidthPct, bbWidthLen)

// RSI
rsiVal = ta.rsi(close, rsiLen)

// India VIX (loaded into the NIFTY chart via request.security)
// Uses prior confirmed bar to avoid lookahead
vixClose = loadVix
     ? request.security("NSE:INDIAVIX", timeframe.period, close[1],
          gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
     : float(na)

// Historical Volatility (20-day, annualized) — proxy for realised vol
// HV = stdev of log returns × sqrt(252) × 100
logReturn   = math.log(close / close[1])
hvDaily     = ta.stdev(logReturn, 20)
hv20Ann     = hvDaily * math.sqrt(252) * 100.0

// ─────────────────────────── Regime Classification ───────────────────────────

// Trend direction from EMA
emaBullish = emaFastVal > emaSlowVal
emaBearish = emaFastVal < emaSlowVal

// Regime label logic (priority: Volatile > Trending > Transitioning > Sideways)
regimeLabel =
     atrPctRank >= 80.0 and adxVal >= adxTrend ? "Volatile-Trending" :
     atrPctRank >= 80.0                         ? "Volatile-Ranging"  :
     adxVal >= adxTrend and emaBullish          ? "Trend-Up"          :
     adxVal >= adxTrend and emaBearish          ? "Trend-Down"        :
     adxVal >= adxChop  and adxVal < adxTrend   ? "Transitioning"     :
                                                  "Sideways"

// Regime numeric code (for MCP to parse without text matching)
// 3=Volatile-Trending, 2=Volatile-Ranging, 1=Trend-Up, -1=Trend-Down,
// 0=Transitioning, -2=Sideways
regimeCode = switch regimeLabel
    "Volatile-Trending" => 3
    "Volatile-Ranging"  => 2
    "Trend-Up"          => 1
    "Trend-Down"        => -1
    "Transitioning"     => 0
    => -2

// Options strategy recommendation derived from regime + VIX
vixLevel =
     not loadVix or na(vixClose) ? "N/A" :
     vixClose >= 20.0            ? "High" :
     vixClose >= 14.0            ? "Mid"  :
                                   "Low"

optionsRec = switch
    regimeCode == -2 and vixLevel == "High" => "Strangle: Aggressive"
    regimeCode == -2 and vixLevel == "Mid"  => "Strangle: Standard"
    regimeCode == -2 and vixLevel == "Low"  => "Strangle: Small/Skip"
    regimeCode == 0  and vixLevel == "High" => "Strangle: Entry Zone"
    regimeCode == 0  and vixLevel == "Mid"  => "Strangle: Watch"
    regimeCode == 1  or regimeCode == -1    => "Collar/CSP Only"
    regimeCode >= 2                         => "Defined Risk Only"
    => "No Trade"

// ─────────────────────────── Output: Table ───────────────────────────────────
// FIXED LAYOUT — row indices must never change (MCP reads by index)
// Row 0:  Header
// Row 1:  regime_label
// Row 2:  regime_code
// Row 3:  options_rec
// Row 4:  adx
// Row 5:  plus_di
// Row 6:  minus_di
// Row 7:  di_spread
// Row 8:  ema_fast
// Row 9:  ema_slow
// Row 10: ema_slope
// Row 11: atr
// Row 12: atr_pct
// Row 13: atr_pct_rank
// Row 14: bb_width_pct
// Row 15: bb_width_rank
// Row 16: rsi
// Row 17: hv_20_ann
// Row 18: vix_close
// Row 19: vix_level
// Row 20: close_price
// Row 21: timestamp (bar date as string)

var table t = table.new(
     position.top_left, 2, 22,
     border_color=color.gray, border_width=1,
     frame_color=color.white, frame_width=1)

if barstate.islast
    // Header
    table.cell(t, 0, 0, "Signal",      text_color=color.white, bgcolor=color.navy,  text_size=size.small)
    table.cell(t, 1, 0, "Value",       text_color=color.white, bgcolor=color.navy,  text_size=size.small)

    // Regime
    regColor = regimeCode >= 1 ? color.green : regimeCode == -1 ? color.red :
               regimeCode == 0 ? color.orange : regimeCode == -2 ? color.blue :
               color.purple
    table.cell(t, 0, 1,  "regime_label",    text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 1,  regimeLabel,        text_color=color.white, bgcolor=regColor,   text_size=size.small)
    table.cell(t, 0, 2,  "regime_code",      text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(regimeCode), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 3,  "options_rec",      text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 3,  optionsRec,         text_color=color.yellow, bgcolor=color.navy, text_size=size.small)

    // ADX block
    table.cell(t, 0, 4,  "adx",             text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(adxVal, "#.##"),   text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 5,  "plus_di",         text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(plusDI,  "#.##"),  text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 6,  "minus_di",        text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 6,  str.tostring(minusDI, "#.##"),  text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 7,  "di_spread",       text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 7,  str.tostring(diSpread, "#.##"), text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // EMA block
    table.cell(t, 0, 8,  "ema_fast",        text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 8,  str.tostring(emaFastVal, "#.##"), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 9,  "ema_slow",        text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 9,  str.tostring(emaSlowVal, "#.##"), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 10, "ema_slope",       text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 10, str.tostring(emaSlope,   "#.####"), text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // ATR block
    table.cell(t, 0, 11, "atr",             text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 11, str.tostring(atrVal,      "#.##"),  text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 12, "atr_pct",         text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 12, str.tostring(atrPct,      "#.####"), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 13, "atr_pct_rank",    text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 13, str.tostring(atrPctRank,  "#.#"),   text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // BB block
    table.cell(t, 0, 14, "bb_width_pct",   text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 14, str.tostring(bbWidthPct,  "#.####"), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 15, "bb_width_rank",  text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 15, str.tostring(bbWidthRank, "#.#"),   text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // RSI and HV
    table.cell(t, 0, 16, "rsi",             text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 16, str.tostring(rsiVal,      "#.##"),  text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 17, "hv_20_ann",       text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 17, str.tostring(hv20Ann,     "#.##"),  text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // VIX block
    vixStr = na(vixClose) ? "N/A" : str.tostring(vixClose, "#.##")
    table.cell(t, 0, 18, "vix_close",       text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 18, vixStr,             text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 19, "vix_level",       text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 19, vixLevel,           text_color=color.white, bgcolor=color.gray, text_size=size.small)

    // Price context
    table.cell(t, 0, 20, "close_price",     text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 20, str.tostring(close, "#.##"), text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 0, 21, "bar_date",        text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(t, 1, 21, str.format("{0,date,yyyy-MM-dd}", time), text_color=color.white, bgcolor=color.gray, text_size=size.small)

// ─────────────────────────── Output: Labels (Key-Value fallback) ──────────────
// One label per major signal group. MCP reads via data_get_pine_labels.
// Labels are placed off-chart at price=0 so they don't clutter the visual.
// Text format: "KEY1:VAL1|KEY2:VAL2|..." — MCP parses the text field.

var label lblRegime  = na
var label lblAdx     = na
var label lblAtr     = na
var label lblVix     = na

if barstate.islast
    label.delete(lblRegime)
    label.delete(lblAdx)
    label.delete(lblAtr)
    label.delete(lblVix)

    lblRegime := label.new(bar_index, 0,
         text  = "regime_label:" + regimeLabel + "|regime_code:" + str.tostring(regimeCode) + "|options_rec:" + optionsRec,
         style = label.style_none,
         color = color.new(color.white, 100),
         textcolor = color.white,
         size  = size.tiny)

    lblAdx := label.new(bar_index, 0,
         text  = "adx:" + str.tostring(adxVal, "#.##") + "|plus_di:" + str.tostring(plusDI, "#.##") + "|minus_di:" + str.tostring(minusDI, "#.##") + "|di_spread:" + str.tostring(diSpread, "#.##"),
         style = label.style_none,
         color = color.new(color.white, 100),
         textcolor = color.white,
         size  = size.tiny)

    lblAtr := label.new(bar_index, 0,
         text  = "atr:" + str.tostring(atrVal, "#.##") + "|atr_pct:" + str.tostring(atrPct, "#.####") + "|atr_pct_rank:" + str.tostring(atrPctRank, "#.#") + "|hv_20_ann:" + str.tostring(hv20Ann, "#.##") + "|rsi:" + str.tostring(rsiVal, "#.##"),
         style = label.style_none,
         color = color.new(color.white, 100),
         textcolor = color.white,
         size  = size.tiny)

    vixStr2 = na(vixClose) ? "N/A" : str.tostring(vixClose, "#.##")
    lblVix := label.new(bar_index, 0,
         text  = "vix_close:" + vixStr2 + "|vix_level:" + vixLevel + "|close:" + str.tostring(close, "#.##") + "|bar_date:" + str.format("{0,date,yyyy-MM-dd}", time),
         style = label.style_none,
         color = color.new(color.white, 100),
         textcolor = color.white,
         size  = size.tiny)

// ─────────────────────────── Output: Lines (key levels) ──────────────────────

var line lineEmaFast = na
var line lineEmaSlow = na
var line lineBbUpper = na
var line lineBbLower = na

if barstate.islast
    line.delete(lineEmaFast)
    line.delete(lineEmaSlow)
    line.delete(lineBbUpper)
    line.delete(lineBbLower)

    lineEmaFast := line.new(bar_index - 1, emaFastVal, bar_index, emaFastVal,
         extend=extend.right, color=color.teal, width=1,
         style=line.style_dashed)
    lineEmaSlow := line.new(bar_index - 1, emaSlowVal, bar_index, emaSlowVal,
         extend=extend.right, color=color.orange, width=1,
         style=line.style_dashed)
    lineBbUpper := line.new(bar_index - 1, bbUpper, bar_index, bbUpper,
         extend=extend.right, color=color.new(color.purple, 60), width=1)
    lineBbLower := line.new(bar_index - 1, bbLower, bar_index, bbLower,
         extend=extend.right, color=color.new(color.purple, 60), width=1)

// ─────────────────────────── Mini Plot (visual confirmation) ─────────────────

plot(adxVal,  "ADX",       color=color.yellow, linewidth=2)
plot(plusDI,  "+DI",       color=color.green,  linewidth=1)
plot(minusDI, "-DI",       color=color.red,    linewidth=1)
hline(adxTrend, "Trend Threshold", color=color.new(color.yellow, 60), linestyle=hline.style_dashed)
hline(adxChop,  "Chop Threshold",  color=color.new(color.gray, 60),   linestyle=hline.style_dotted)

bgcolor(regimeCode == -2 ? color.new(color.blue, 90) :
        regimeCode == 0  ? color.new(color.orange, 90) :
        regimeCode == 1  ? color.new(color.green, 90) :
        regimeCode == -1 ? color.new(color.red, 90) :
        regimeCode >= 2  ? color.new(color.purple, 90) :
        color.new(color.gray, 95), title="Regime Background")
